# Copy to .env.tunnel (gitignored, mode 0600) and fill in your values.
#   cp .env.tunnel.example .env.tunnel && chmod 600 .env.tunnel

# Public hostname mapped to this Mac in the Cloudflare dashboard.
# HEIR_STUDIO_TUNNEL_HOSTNAME=studio.example.com

# Dashboard-managed tunnel token (written to ~/.cloudflared/heir-studio.token).
# CLOUDFLARE_TUNNEL_TOKEN=

# Or a locally-managed named tunnel (requires `cloudflared tunnel login`).
# HEIR_STUDIO_TUNNEL_NAME=heir-studio

# Cloudflare Access service token, so the iPhone can skip the email OTP.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# APNs (optional). Token auth needs both team id and a .p8 path.
# HEIR_STUDIO_APNS_TEAM_ID=
# HEIR_STUDIO_APNS_KEY_ID=
# HEIR_STUDIO_APNS_KEY_PATH=
# HEIR_STUDIO_APNS_BUNDLE_ID=com.heir.studio.mobile
# HEIR_STUDIO_APNS_PRODUCTION=1
