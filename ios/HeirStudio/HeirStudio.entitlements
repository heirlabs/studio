<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Declared explicitly: without a keychain access group the Keychain returns
	  errSecMissingEntitlement (-34018) and the pairing token cannot be stored
	  at all. Relying on automatic signing to inject it silently breaks any
	  build made without full signing.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.heir.studio.mobile</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
